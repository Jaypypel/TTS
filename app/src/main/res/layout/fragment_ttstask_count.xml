<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout15"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TTSTaskCountFragment">


    <TextView
        android:id="@+id/textViewTaskCountUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"

        app:layout_constraintEnd_toStartOf="@+id/textViewTaskCountDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textViewTaskCountDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="right"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewTaskCountTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewTaskCountUser"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewTaskCountTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:gravity="right"
        app:layout_constraintBottom_toTopOf="@+id/textViewAcceptedTask"
        app:layout_constraintEnd_toEndOf="@+id/textViewTaskCountDate"
        app:layout_constraintStart_toStartOf="@+id/textViewTaskCountDate"
        app:layout_constraintTop_toBottomOf="@+id/textViewTaskCountDate"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewPendingTask"
        android:layout_width="197dp"
        android:layout_height="48dp"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/textViewApprovalTask"
        app:layout_constraintEnd_toStartOf="@+id/textViewAcceptedTask"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTaskCountUser"
        app:layout_constraintWidth_percent="0.48" />

    <TextView
        android:id="@+id/textViewAcceptedTask"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/textViewPendingTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewPendingTask"
        app:layout_constraintTop_toTopOf="@+id/textViewPendingTask"
        app:layout_constraintWidth_percent="0.48" />

    <TextView
        android:id="@+id/textViewApprovalTask"
        android:layout_width="197dp"
        android:gravity="center"
        android:layout_height="48dp"
        app:layout_constraintBottom_toTopOf="@+id/textViewWDSUser"
        app:layout_constraintEnd_toStartOf="@+id/textViewCompletedTask"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewPendingTask"
        app:layout_constraintWidth_percent="0.48" />

    <TextView
        android:id="@+id/textViewCompletedTask"
        android:layout_width="198dp"
        android:layout_height="48dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/textViewApprovalTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewApprovalTask"
        app:layout_constraintTop_toTopOf="@+id/textViewApprovalTask"
        app:layout_constraintWidth_percent="0.30" />


    <TextView
        android:id="@+id/textViewWDSUser"

        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="User"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewWDSDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.15"
        app:layout_constraintTop_toBottomOf="@+id/textViewApprovalTask"
        tools:layout_editor_absoluteY="192dp" />

    <TextView
        android:id="@+id/textViewWDSDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Date"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewWDSUser"
        app:layout_constraintEnd_toStartOf="@+id/textViewWDSTask"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewWDSUser"
        app:layout_constraintTop_toTopOf="@+id/textViewWDSUser"
        app:layout_constraintWidth_percent="0.15" />

    <TextView
        android:id="@+id/textViewWDSTask"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Task"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewWDSDate"
        app:layout_constraintEnd_toStartOf="@+id/textViewWDSStatus"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewWDSDate"
        app:layout_constraintTop_toTopOf="@+id/textViewWDSDate"
        app:layout_constraintWidth_percent="0.5" />

    <TextView
        android:id="@+id/textViewWDSStatus"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Status"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewWDSTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintStart_toEndOf="@+id/textViewWDSTask"
        app:layout_constraintTop_toTopOf="@+id/textViewWDSTask"
        app:layout_constraintWidth_percent="0.2" />

    <ListView
        android:id="@+id/taskList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.74"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="240dp"
        app:layout_constraintTop_toBottomOf="@id/textViewWDSTask"/>

</androidx.constraintlayout.widget.ConstraintLayout>