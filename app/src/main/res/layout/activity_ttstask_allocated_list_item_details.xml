<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
    tools:context=".TTSTaskAllocatedListItemDetailsActivity">


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2 columns -->


    <TextView
        android:id="@+id/textViewTALIDUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView18"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintWidth_percent="0.48" />

    <TextView
        android:id="@+id/textViewTALIDDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewTALIDUser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewTALIDUser"
        app:layout_constraintTop_toTopOf="@+id/textViewTALIDUser"
        app:layout_constraintWidth_percent="0.48" />

    <TextView
        android:id="@+id/textView18"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintWidth_percent="0.34"
        android:text="Activity Name"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView19"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDActName"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTALIDUser"
        />


    <TextView
        android:id="@+id/textViewTALIDActName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintWidth_percent="0.64"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/textView18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView18"
        app:layout_constraintTop_toTopOf="@+id/textView18"
       />

    <TextView
        android:id="@+id/textView19"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Task Name"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView13"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDTaskName"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView18"
        app:layout_constraintWidth_percent="0.34" />

    <TextView
        android:id="@+id/textViewTALIDTaskName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/textView19"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView19"
        app:layout_constraintTop_toTopOf="@+id/textView19"
        app:layout_constraintWidth_percent="0.64" />

    <TextView
        android:id="@+id/textView13"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Project Code"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView20"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDProjNo"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView19"
        app:layout_constraintWidth_percent="0.34" />


    <TextView
        android:id="@+id/textViewTALIDProjNo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/textView13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView13"
        app:layout_constraintTop_toTopOf="@+id/textView13"
        app:layout_constraintWidth_percent="0.64" />

    <TextView
        android:id="@+id/textView20"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Project Name"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView14"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDProjName"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13"
        app:layout_constraintWidth_percent="0.34" />


    <TextView
        android:id="@+id/textViewTALIDProjName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/textView20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView20"
        app:layout_constraintTop_toTopOf="@+id/textView20"
        app:layout_constraintWidth_percent="0.64" />

    <TextView
        android:id="@+id/textView14"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Expected Date"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView15"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDExpDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView20"
        app:layout_constraintWidth_percent="0.34" />


    <TextView
        android:id="@+id/textViewTALIDExpDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/textView14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView14"
        app:layout_constraintTop_toTopOf="@+id/textView14"
        app:layout_constraintWidth_percent="0.64" />


    <!-- 2 columns -->


    <!-- 2 columns -->


    <!-- 2 columns -->


    <!-- 2 columns -->


    <TextView
        android:id="@+id/textView15"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Expected Time"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView16"
        app:layout_constraintEnd_toStartOf="@+id/textViewTALIDExpTime"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView14"
        app:layout_constraintWidth_percent="0.34" />

    <TextView
        android:id="@+id/textViewTALIDExpTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/textView15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView15"
        app:layout_constraintTop_toTopOf="@+id/textView15"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintWidth_percent="0.64" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:text="Measurables"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/listMeasurableTALID"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTALIDDescription"
        app:layout_constraintWidth_percent="0.34" />

    <ListView
        android:id="@+id/listMeasurableTALID"
        android:layout_width="match_parent"
        android:layout_height="61dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonTALIDModify"
        app:layout_constraintStart_toStartOf="@+id/textView12"
        app:layout_constraintTop_toBottomOf="@+id/textView12" />

    <TextView
        android:id="@+id/textView16"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:text="Description"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewTALIDDescription"
        app:layout_constraintStart_toStartOf="@+id/textViewTALIDDescription"
        app:layout_constraintTop_toBottomOf="@+id/textView15"
        app:layout_constraintWidth_percent="0.34" />

    <TextView
        android:id="@+id/textViewTALIDDescription"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:clickable="false"
        android:inputType="textMultiLine"
        android:maxLines="6"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTALIDExpTime"
        app:layout_constraintVertical_chainStyle="spread_inside" />

    <Button
        android:id="@+id/buttonTALIDAccept"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Accept"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/buttonTALIDDisplayTimeShare"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/buttonTALIDModify"
        app:layout_constraintTop_toBottomOf="@+id/listMeasurableTALID"
        app:layout_constraintWidth_percent="0.45" />

    <Button
        android:id="@+id/buttonTALIDDisplayTimeShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Timeshares"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonTALIDAccept" />

    <Button
        android:id="@+id/buttonTALIDModify"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Modify"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/buttonTALIDAccept"
        app:layout_constraintEnd_toStartOf="@+id/buttonTALIDAccept"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonTALIDAccept"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_percent="0.45" />


</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fragment container inside ConstraintLayout -->


