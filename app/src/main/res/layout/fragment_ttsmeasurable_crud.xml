<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TTSMeasurableCRUDFragment">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rowCount="2"
        android:columnCount="2"
        >

        <TextView
            android:id="@+id/textViewMeasurableCRUDUser"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="0"
            android:gravity="center_vertical"
            android:textColor="@android:color/black"
            android:textStyle="bold"  />

        <TextView
            android:id="@+id/textViewMeasurableCRUDDate"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="0"
            android:gravity="right"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewMeasurableCRUDTime"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="1"
            android:gravity="right"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

    </GridLayout>
    <Spinner
        android:id="@+id/spinnerMeasurableCRUDUserSelect"
        android:layout_width="225dp"
        android:layout_height="35dp"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="90dp"
        android:spinnerMode="dialog" />


    <AutoCompleteTextView
        android:id="@+id/editTextMeasurableCRUDMeasurable"
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="155dp"
        android:ems="10"
        android:hint="Enter Measurable"
        android:inputType="textPersonName" />

    <Button
        android:id="@+id/buttonMeasurableCRUDAddMeasurable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="130dp"
        android:layout_marginTop="220dp"
        android:text="Add measurable"
        android:textStyle="bold" />
</RelativeLayout>