<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayout13"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TTSTaskCommittedListFragment">

    <TextView
        android:id="@+id/textViewProcessingListUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewProcessingListDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textViewProcessingListDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewProcessingListUser"
        app:layout_constraintTop_toTopOf="@+id/textViewProcessingListUser"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.45"   />

    <TextView
        android:id="@+id/textViewProcessingListTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewProcessingListTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewProcessingListDate"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewProcessingListTaskUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="User"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewProcessingListTaskDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewProcessingListUser"
        app:layout_constraintWidth_percent="0.20"/>

    <TextView
        android:id="@+id/textViewProcessingListTaskDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Date"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewProcessingListUser"
        app:layout_constraintEnd_toStartOf="@+id/textViewProcessingListTask"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewProcessingListTaskUser"
        app:layout_constraintWidth_percent="0.20"/>

    <TextView
        android:id="@+id/textViewProcessingListTask"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Task"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewProcessingListTime"
        app:layout_constraintEnd_toStartOf="@+id/textViewProcessingListStatus"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewProcessingListTaskDate"
        app:layout_constraintWidth_percent="0.40"/>

    <TextView
        android:id="@+id/textViewProcessingListStatus"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Status"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewProcessingListTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewProcessingListTask"
        app:layout_constraintWidth_percent="0.20"/>


    <ListView
        android:id="@+id/processingTaskList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewProcessingListTask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.65"/>

    <TextView
        android:id="@+id/committedTasksState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:text="No commited task available!"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewProcessingListTask"/>
</androidx.constraintlayout.widget.ConstraintLayout>