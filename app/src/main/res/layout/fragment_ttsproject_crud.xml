<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TTSProjectCRUDFragment">


    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rowCount="2"
        android:columnCount="2"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/textViewProjectCRUDUser"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="0"
            android:gravity="center_vertical"
            android:textColor="@android:color/black"
            android:textStyle="bold"  />

        <TextView
            android:id="@+id/textViewProjectCRUDDate"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="0"
            android:gravity="right"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewProjectCRUDTime"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="1"
            android:gravity="right"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

    </GridLayout>


    <Spinner
        android:id="@+id/spinnerProjectCRUDActivitySelect"
        android:layout_width="wrap_content"
        android:gravity="center"
        android:layout_height="56dp"
        android:layout_marginTop="140dp"
        android:spinnerMode="dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <AutoCompleteTextView
        android:id="@+id/editTextProjectCRUDProjectCode"
        android:gravity="center"
        android:layout_width="225dp"
        android:layout_height="56dp"
        android:layout_marginTop="195dp"
        android:ems="10"
        android:hint="Enter Project Code"
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Spinner
        android:id="@+id/spinnerProjectCRUDUserSelect"
        android:layout_width="225dp"
        android:layout_height="56dp"
        android:layout_marginTop="80dp"
        android:spinnerMode="dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <AutoCompleteTextView
        android:id="@+id/editTextProjectCRUDProjectName"
        android:gravity="center"
        android:layout_width="225dp"
        android:layout_height="56dp"
        android:layout_marginTop="260dp"
        android:ems="10"
        android:hint="Enter Project Name"
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonProjectCRUDAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="330dp"
        android:text="Add Project"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>