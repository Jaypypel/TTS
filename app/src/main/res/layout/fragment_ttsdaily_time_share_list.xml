<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".TTSDailyTimeShareListFragment">


    <TextView
        android:id="@+id/textViewDailyTimeShareListUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewDailyTimeShareListDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewDailyTimeShareListDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="end"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDailyTimeShareListUser"
        app:layout_constraintTop_toTopOf="@+id/textViewDailyTimeShareListUser"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewDailyTimeShareListTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewDailyTimeShareListTaskName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewDailyTimeShareListDate"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textViewDailyTimeShareListStartTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Start Time"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewDailyTimeShareListEndTime"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewDailyTimeShareListUser"
        app:layout_constraintWidth_percent="0.20"
        tools:layout_editor_absoluteY="107dp" />

    <TextView
        android:id="@+id/textViewDailyTimeShareListEndTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="End Time"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewDailyTimeShareListUser"
        app:layout_constraintEnd_toStartOf="@+id/textViewDailyTimeShareListTaskName"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDailyTimeShareListStartTime"
        app:layout_constraintWidth_percent="0.20"
        tools:layout_editor_absoluteY="107dp" />

    <TextView
        android:id="@+id/textViewDailyTimeShareListTaskName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Task"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewDailyTimeShareListTime"
        app:layout_constraintEnd_toStartOf="@+id/textViewDailyTimeShareListProjName"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDailyTimeShareListEndTime"
        app:layout_constraintWidth_percent="0.40"
        tools:layout_editor_absoluteY="107dp" />

    <TextView
        android:id="@+id/textViewDailyTimeShareListProjName"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Project"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewDailyTimeShareListTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDailyTimeShareListTaskName"
        app:layout_constraintWidth_percent="0.20"
        tools:layout_editor_absoluteY="107dp" />

    <ListView
        android:id="@+id/listDailyTimeShare"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewDailyTimeShareListTaskName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.65"
        tools:layout_editor_absoluteY="162dp" />

    <TextView
        android:id="@+id/dailyTimeShares"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:text="No Daily Time Share Available!"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewDailyTimeShareListTaskName" />


</androidx.constraintlayout.widget.ConstraintLayout>