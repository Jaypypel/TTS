        android:layout_height="56dp"
        android:hint="Enter Project name"
        android:maxHeight="56dp"
        android:minHeight="48dp"
        app:layout_constraintBottom_toTopOf="@+id/textInputLayout35"
        app:layout_constraintEnd_toEndOf="parent"
