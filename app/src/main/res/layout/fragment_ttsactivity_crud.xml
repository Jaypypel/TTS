<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TTSActivityCRUDFragment">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:rowCount="2"
        android:columnCount="2"
        >

        <TextView
            android:id="@+id/textViewActCRUDUser"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_row="0"
            android:gravity="center_vertical"

            android:textStyle="bold"  />

        <TextView
            android:id="@+id/textViewActCRUDDate"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="0"
            android:gravity="right"

            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewActCRUDTime"
            android:padding="5dp"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_row="1"
            android:gravity="right"

            android:textStyle="bold" />

    </GridLayout>


    <Spinner
        android:id="@+id/spinnerActCRUDUserSelect"
        android:layout_width="225dp"
        android:layout_height="35dp"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="80dp"
        android:spinnerMode="dialog" />

    <AutoCompleteTextView
        android:id="@+id/editTextActCRUDActivity"
        android:layout_width="225dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="60dp"
        android:layout_marginTop="130dp"
        android:ems="10"
        android:hint="Enter Activity"
        android:inputType="textPersonName" />

    <Button
        android:id="@+id/buttonActCRUDAddAct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="120dp"
        android:layout_marginTop="200dp"
        android:text="Add activity"
        android:textStyle="bold" />
</RelativeLayout>