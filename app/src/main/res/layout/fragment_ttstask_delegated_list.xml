<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TTSTaskDelegatedListFragment">


    <TextView
        android:id="@+id/textViewDelegatedListUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewDelegatedListDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textViewDelegatedListDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDelegatedListUser"
        app:layout_constraintTop_toTopOf="@+id/textViewDelegatedListUser"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.45"  />

    <TextView
        android:id="@+id/textViewDelegatedListTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewDelegatedListTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewDelegatedListDate"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewDelegatedListTaskUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="User"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewDelegatedListTaskDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewDelegatedListUser"
        app:layout_constraintWidth_percent="0.20"/>

    <TextView
        android:id="@+id/textViewDelegatedListTaskDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Date"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewDelegatedListUser"
        app:layout_constraintEnd_toStartOf="@+id/textViewDelegatedListTask"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDelegatedListTaskUser"
        app:layout_constraintWidth_percent="0.20"/>

    <TextView
        android:id="@+id/textViewDelegatedListTask"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Task"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewDelegatedListTime"
        app:layout_constraintEnd_toStartOf="@+id/textViewDelegatedListStatus"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDelegatedListTaskDate"
        app:layout_constraintWidth_percent="0.40"/>

    <TextView
        android:id="@+id/textViewDelegatedListStatus"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Status"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewDelegatedListTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewDelegatedListTask"
        app:layout_constraintWidth_percent="0.20" />
    
    <ListView
        android:id="@+id/listTaskDelegated"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewDelegatedListTask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.65"/>

    <TextView
        android:id="@+id/assignedTasksState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:text="No assigned task available!"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewDelegatedListTask" />

</androidx.constraintlayout.widget.ConstraintLayout>