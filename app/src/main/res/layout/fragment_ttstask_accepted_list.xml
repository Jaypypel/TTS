<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayout10"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TTSTaskAcceptedListFragment">


    <TextView
        android:id="@+id/textViewAcceptedListUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewAcceptedListDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/textViewAcceptedListDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewAcceptedListUser"
        app:layout_constraintTop_toTopOf="@+id/textViewAcceptedListUser"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_percent="0.45"  />

    <TextView
        android:id="@+id/textViewAcceptedListTime"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewAcceptedListTask"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewAcceptedListDate"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_percent="0.45" />


    <TextView
        android:id="@+id/textViewAcceptedListTaskUser"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="User"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/textViewAcceptedListTaskDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewAcceptedListUser"
        app:layout_constraintWidth_percent="0.20"/>

    <TextView
        android:id="@+id/textViewAcceptedListTaskDate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Date"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewAcceptedListUser"
        app:layout_constraintEnd_toStartOf="@+id/textViewAcceptedListTask"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewAcceptedListTaskUser"
        app:layout_constraintWidth_percent="0.20"/>

    <TextView
        android:id="@+id/textViewAcceptedListTask"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Task"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewAcceptedListTime"
        app:layout_constraintEnd_toStartOf="@+id/textViewAcceptedListStatus"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewAcceptedListTaskDate"
        app:layout_constraintWidth_percent="0.40"/>

    <TextView
        android:id="@+id/textViewAcceptedListStatus"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Status"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textViewAcceptedListTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textViewAcceptedListTask"
        app:layout_constraintWidth_percent="0.20"/>


    <ListView
        android:id="@+id/listAccepted"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/textViewAcceptedListTask"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.65"/>

    <TextView
        android:id="@+id/acceptedTasksState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:text="No accepted task available!"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewAcceptedListTask"/>

</androidx.constraintlayout.widget.ConstraintLayout>